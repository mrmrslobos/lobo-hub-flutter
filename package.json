{
  "name": "lobohub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "assets:generate": "npx capacitor-assets generate --assetPath assets",
    "cap:sync": "npm run build && npx cap sync",
