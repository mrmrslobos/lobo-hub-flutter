    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@google/genai": "^1.41.0",
    "@revenuecat/purchases-capacitor": "^12.1.3",
    "@revenuecat/purchases-capacitor-ui": "^12.1.3",
    "@supabase/supabase-js": "^2.48.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.564.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-is": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0"
