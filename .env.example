# Copy this file to .env and fill in your values.
# docker compose will automatically read .env when you run:
#   docker compose up --build

# Supabase — get these from your Supabase project settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Gemini — get your key from https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override the Gemini model (defaults to gemini-2.0-flash)
# VITE_GEMINI_MODEL=gemini-2.0-flash
