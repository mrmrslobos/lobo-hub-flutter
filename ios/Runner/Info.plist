<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Huddle</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Huddle</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Huddle uses the microphone so you can speak requests to Ask Huddle.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Huddle uses on-device speech recognition to turn your voice into text for Ask Huddle.</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Huddle needs camera access to take photos for your family album.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Huddle needs photo library access to share family photos.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Huddle needs permission to save photos to your library.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Huddle uses your location to share with family members.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Huddle uses Face ID to keep your family data private.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Huddle can read workout-related data from Apple Health when you choose to connect it.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Huddle saves completed workouts to Apple Health when you enable sync in Fitness.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.opensolutions.huddle</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.opensolutions.huddle</string>
			</array>
		</dict>
		<!-- Google Sign-In: Replace with your reversed client ID from GoogleService-Info.plist -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.YOUR_IOS_CLIENT_ID</string>
			</array>
		</dict>
	</array>
	<key>GIDClientID</key>
	<string>YOUR_IOS_CLIENT_ID.apps.googleusercontent.com</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UISupportedExternalAccessoryProtocols</key>
	<array/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
